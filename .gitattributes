# 统一换行符，避免 Windows / Linux 协作时整文件显示成"已修改"
* text=auto

# 仓库里的所有文本文件在仓库中都存成 LF
*.md    text eol=lf
*.mts   text eol=lf
*.mjs   text eol=lf
*.ts    text eol=lf
*.vue   text eol=lf
*.css   text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.svg   text eol=lf

# Windows 批处理文件必须保留 CRLF
*.bat   text eol=crlf
*.cmd   text eol=crlf

# 图片等二进制文件不要做换行符转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.woff  binary
*.woff2 binary

# PDF 与常见附件必须声明为 binary。
# 没有这几行时，上面的 * text=auto 会把 PDF 当文本处理（git 会报
# "LF will be replaced by CRLF"），checkout 时的换行符转换有损坏风险，
# diff 也会按文本输出乱码。
*.pdf   binary
*.zip   binary
*.7z    binary
*.rar   binary
*.gz    binary
*.mp3   binary
*.mp4   binary
*.mov   binary
*.wav   binary
*.ttf   binary
*.otf   binary
*.doc   binary
*.docx  binary
*.xls   binary
*.xlsx  binary
*.ppt   binary
*.pptx  binary
