# 统一换行符，避免 Windows / Linux 协作时整文件显示成"已修改"
* text=auto

# 仓库里的所有文本文件在仓库中都存成 LF
*.md    text eol=lf
*.mts   text eol=lf
*.mjs   text eol=lf
*.ts    text eol=lf
*.vue   text eol=lf
*.css   text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.svg   text eol=lf

# Windows 批处理文件必须保留 CRLF
*.bat   text eol=crlf
*.cmd   text eol=crlf

# 图片等二进制文件不要做换行符转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.woff  binary
*.woff2 binary
